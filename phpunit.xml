<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <!-- Sem subdiretório nos testes de feature; /fauvovet é coberto pelo E2E (servidor real). -->
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- MySQL real (Percona 5.7 local); o nome do banco DEVE terminar com _test (TestCase recusa outro). -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="fauvovet_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="SESSION_PATH" value="/fauvovet" force="true"/>
        <env name="SESSION_ENCRYPT" value="true" force="true"/>
        <env name="HASH_DRIVER" value="argon2id" force="true"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="SEED_PASSWORD" value="senha-de-teste-ficticia" force="true"/>
        <env name="FAUVOVET_ALLOW_SELF_SIGNUP" value="true" force="true"/>
        <env name="DEPLOY_TOOLS_ENABLED" value="false" force="true"/>
        <!-- O Laravel lê $_SERVER antes de $_ENV: força também aqui as variáveis que definem o banco de teste. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_DATABASE" value="fauvovet_test" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
