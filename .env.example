# FauvoVet — variáveis de ambiente de EXEMPLO (valores fictícios, somente desenvolvimento local).
# Copie para .env (o bootstrap faz isso sem sobrescrever um .env existente).
# NUNCA versionar .env com valores reais.

NODE_ENV=development

# Caminho base público (subdiretório). Ex.: /fauvovet. Use vazio para hospedar na raiz.
BASE_PATH=/fauvovet

# Portas locais
WEB_PORT=3000
API_PORT=4000
# URL interna usada pelo Next.js (dev) para encaminhar /fauvovet/api -> API
API_INTERNAL_URL=http://127.0.0.1:4000
# Origem pública da aplicação (validação de Origin em requisições mutáveis)
PUBLIC_ORIGIN=http://localhost:3000

# PostgreSQL local (embutido via `pnpm db:start` ou Docker Compose em infra/docker)
LOCAL_PG_PORT=54329
LOCAL_PG_SUPERUSER_PASSWORD=dev-only-superuser-change-me

# Papel da aplicação: SEM superuser e SEM BYPASSRLS (RLS sempre aplicada)
DATABASE_URL=postgres://fauvovet_app:dev-only-app-change-me@127.0.0.1:54329/fauvovet_dev
# Papel de migração (dono das tabelas); usado só por db:migrate e db:seed
MIGRATION_DATABASE_URL=postgres://fauvovet_migrator:dev-only-migrator-change-me@127.0.0.1:54329/fauvovet_dev

# Banco de testes (nome DEVE terminar com _test; os testes recusam outro nome)
TEST_DATABASE_URL=postgres://fauvovet_app:dev-only-app-change-me@127.0.0.1:54329/fauvovet_test
TEST_MIGRATION_DATABASE_URL=postgres://fauvovet_migrator:dev-only-migrator-change-me@127.0.0.1:54329/fauvovet_test

# Sessão
SESSION_TTL_HOURS=12
# true em produção (HTTPS). Em localhost http use false.
COOKIE_SECURE=false

# Cadastro público de novas clínicas (onboarding). Em produção, decidir comercialmente.
ALLOW_SELF_SIGNUP=true

# Senha dos usuários FICTÍCIOS criados por `pnpm db:seed` (somente desenvolvimento)
SEED_PASSWORD=fauvovet-demo-2026
