# FauvoVet — variáveis de EXEMPLO (valores fictícios; somente desenvolvimento local).
# `pnpm bootstrap` copia para .env sem sobrescrever um .env existente. NUNCA versionar .env real.
# Produção: o .env é criado direto no servidor (fora de public_html) — ver docs/DEPLOY_LOCAWEB.md.

APP_NAME=FauvoVet
APP_ENV=local
# Gerada por `php artisan key:generate` (o bootstrap faz isso). Nunca reutilize a chave de produção.
APP_KEY=
APP_DEBUG=true
# URL pública COMPLETA, incluindo o subdiretório. Produção: https://dradeboragakdino.com.br/fauvovet
APP_URL=http://127.0.0.1:8000/fauvovet
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 5.7+ (produção: banco do painel Locaweb). Local: `pnpm db:setup` sobe Percona 5.7 sem root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33079
DB_DATABASE=fauvovet_dev
DB_USERNAME=fauvovet
DB_PASSWORD=dev-only-db-change-me
# Banco usado pelos testes (o nome DEVE terminar com _test; os testes recusam outro)
DB_TEST_DATABASE=fauvovet_test

# Sessão no banco (sem Redis). Cookie restrito ao subdiretório.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/fauvovet
SESSION_DOMAIN=null
# true em produção (HTTPS). Em http://127.0.0.1 use false.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=fauvovet_session

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Senhas: argon2id quando o PHP suporta (verificado em /_deploy/diagnostico), senão bcrypt.
HASH_DRIVER=argon2id

# Cadastro público de novas clínicas. Em produção é decisão comercial (padrão do código: false).
FAUVOVET_ALLOW_SELF_SIGNUP=true
FAUVOVET_LOGIN_MAX_FAILURES=10
FAUVOVET_LOGIN_LOCK_MINUTES=15

# Ferramentas de deploy sem SSH (migração/diagnóstico via HTTP). Mantenha false fora da janela de deploy.
DEPLOY_TOOLS_ENABLED=false
# Hash SHA-256 do token de deploy (gere com `pnpm deploy:token`); o token em si NUNCA vai para arquivo.
DEPLOY_TOKEN_SHA256=

# Senha dos usuários FICTÍCIOS criados por `pnpm db:seed` (somente desenvolvimento)
SEED_PASSWORD=fauvovet-demo-2026
