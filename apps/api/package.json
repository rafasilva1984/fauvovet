{
  "name": "@fauvovet/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "node ../../scripts/api-dev.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:tenant-isolation": "vitest run --project integration test/isolation",
    "db:migrate": "node --env-file-if-exists=../../.env dist/db/migrate-cli.js",
    "db:seed": "node --env-file-if-exists=../../.env dist/db/seed-cli.js",
    "perf:check": "node --env-file-if-exists=../../.env dist/perf/perf-cli.js"
  },
  "dependencies": {
    "@fauvovet/contracts": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
