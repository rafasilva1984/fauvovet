# FauvoVet — .env de PRODUÇÃO (modelo). Copie para app-fauvovet/.env NO SERVIDOR e preencha lá.
# NUNCA versionar o arquivo preenchido. Valores entre <> são para você substituir.

APP_NAME=FauvoVet
APP_ENV=production
APP_DEBUG=false
# Gere localmente com: node scripts/php.mjs artisan key:generate --show   (uma chave só para produção)
APP_KEY=<base64:...>
APP_URL=https://dradeboragakdino.com.br/fauvovet
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Banco MySQL criado no painel da Locaweb (host costuma ser *.mysql.dbaas.com.br)
DB_CONNECTION=mysql
DB_HOST=<host do painel>
DB_PORT=3306
DB_DATABASE=<nome do banco>
DB_USERNAME=<usuário do banco>
DB_PASSWORD=<senha do banco>

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/fauvovet
SESSION_DOMAIN=null
# true SOMENTE depois que o HTTPS estiver ativo no domínio (com false o cookie trafega sem TLS)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=fauvovet_session

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
HASH_DRIVER=argon2id

# Cadastro público de clínicas: decisão comercial. Recomendado false até haver verificação de e-mail.
FAUVOVET_ALLOW_SELF_SIGNUP=false
FAUVOVET_LOGIN_MAX_FAILURES=10
FAUVOVET_LOGIN_LOCK_MINUTES=15

# Ferramentas de deploy: true só durante a janela de deploy; depois volte para false.
DEPLOY_TOOLS_ENABLED=false
# Gere com: pnpm deploy:token   (guarde o TOKEN no gerenciador de senhas; aqui vai só o SHA-256)
DEPLOY_TOKEN_SHA256=<sha256 do token>
