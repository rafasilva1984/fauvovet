{
  "name": "fauvovet",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "FauvoVet — plataforma SaaS multi-tenant para medicina veterinária",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "db:setup": "node scripts/local-mysql.mjs setup",
    "db:start": "node scripts/local-mysql.mjs start",
    "db:stop": "node scripts/local-mysql.mjs stop",
    "db:status": "node scripts/local-mysql.mjs status",
    "db:migrate": "node scripts/php.mjs artisan migrate --force",
    "db:seed": "node scripts/php.mjs artisan db:seed --force",
    "lint": "node scripts/php.mjs vendor/bin/pint --test && prettier --check .",
    "format": "node scripts/php.mjs vendor/bin/pint && prettier --write .",
    "analyse": "node scripts/php.mjs vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
    "test": "node scripts/php.mjs artisan test --compact",
    "test:tenant-isolation": "node scripts/php.mjs artisan test --compact --group=tenant-isolation",
    "test:e2e": "playwright test",
    "perf:check": "node scripts/perf.mjs",
    "docs:validate": "node scripts/docs-validate.mjs",
    "security:secrets": "node scripts/secrets-scan.mjs",
    "security:audit": "composer audit --no-dev --locked",
    "deploy:token": "node scripts/deploy-token.mjs",
    "deploy:package": "node scripts/deploy-package.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "deploy:remote": "node scripts/deploy-remote.mjs"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.17.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "laravel-vite-plugin": "^3.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
